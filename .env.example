# Copy this file to .env and fill in the values. On Vercel, add the same names under
# Project > Settings > Environment Variables, then redeploy.

# Supabase > Project Settings > Data API / API Keys (use the publishable key, never the secret key)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe Payment Link, e.g. https://donate.stripe.com/...
VITE_DONATE_URL=

# Optional: contact form key from https://web3forms.com
VITE_WEB3FORMS_KEY=
